<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ElectricFishMachine</RootNamespace>
    <AssemblyName>ElectricFishMachine</AssemblyName>
    <Version>1.2.0</Version>
    <EnableHarmony>true</EnableHarmony>
    <ModFolderName>ElectricFishMachine</ModFolderName>
  </PropertyGroup>

  <!-- 发布 Release 到 N 网时不需要 .pdb；本地 Debug 仍默认带符号便于调试 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 禁用 ModBuildConfig 的「版本号外层 + 模组内层」zip，改由下方目标打扁平包 -->
    <EnableModZip>false</EnableModZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 若有贴图/音频等再放 assets 下并取消注释；无文件时不要 Include，否则输出里易出现空 assets 目录 -->
  <!--
  <ItemGroup>
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  -->

  <!--
    Release zip 根目录即为 manifest.json、dll 等（无 ElectricFishMachine 1.2.0/ElectricFishMachine 双层目录）。
    安装：在 Mods 下新建 ElectricFishMachine 文件夹，将 zip 解压到该文件夹内。
  -->
  <Target Name="CreateFlatReleaseZip" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_ModDeployDir>$(GameModsPath)\$(ModFolderName)</_ModDeployDir>
      <_ReleaseZip>$(TargetDir)$(ModFolderName).zip</_ReleaseZip>
    </PropertyGroup>
    <Message Importance="high" Text="[ElectricFishMachine] 生成扁平发布 zip: $(_ReleaseZip)" />
    <Delete Files="$(_ReleaseZip)" Condition="Exists('$(_ReleaseZip)')" />
    <Exec Command="powershell -NoProfile -Command &quot;Compress-Archive -Path '$(_ModDeployDir)\*' -DestinationPath '$(_ReleaseZip)' -Force&quot;" />
  </Target>

</Project>
